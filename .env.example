# CANDRON OneERP — environment
# Copy to .env and fill in real values.

# --- Database ---------------------------------------------------------------
# Local dev (SQLite, default): a file next to the Prisma schema.
DATABASE_URL="file:./dev.db"
# Production (Postgres) — see DEPLOYMENT.md; also switch the datasource
# provider in prisma/schema.prisma to "postgresql".
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oneerp?schema=public"

# --- Auth -------------------------------------------------------------------
# Secret used to sign the JWT session cookie. Generate a strong one:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"
