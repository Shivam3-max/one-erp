# CANDRON OneERP — environment
# Copy to .env and fill in real values. The app refuses to start without a
# database configuration and AUTH_SECRET (no insecure fallbacks).

# --- Database (MySQL) -------------------------------------------------------
# Option A — a full connection string (used as-is when set):
DATABASE_URL="mysql://oneerp:CHANGE_ME@localhost:3306/oneerp"

# Option B — Hostinger shape: set the discrete parts instead and the app
# composes the URL. hPanel gives you a database name and user as separate
# fields, usually prefixed (e.g. u1234567_oneerp). Leave DATABASE_URL unset
# (or blank) to use these. DATABASE_URL wins if both are present.
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_NAME="u1234567_oneerp"
# DB_USER="u1234567_oneerp"
# DB_PASSWORD="CHANGE_ME"
# DB_PARAMS=""            # optional extra query string, e.g. connection_limit=5

# --- Auth -------------------------------------------------------------------
# Secret used to sign the JWT session cookie. REQUIRED. Generate a strong one:
#   openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_run_openssl_rand_base64_48"
