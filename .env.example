# CANDRON OneERP — environment
# Copy to .env and fill in real values. Both variables are REQUIRED — the app
# refuses to start without them (no insecure fallbacks).

# --- Database (MySQL) -------------------------------------------------------
# Hostinger: create the database + user in hPanel, then use that host/credentials.
# Format: mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL="mysql://oneerp:CHANGE_ME@localhost:3306/oneerp"

# --- Auth -------------------------------------------------------------------
# Secret used to sign the JWT session cookie. REQUIRED. Generate a strong one:
#   openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_run_openssl_rand_base64_48"
