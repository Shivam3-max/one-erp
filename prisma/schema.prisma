// CANDRON OneERP — data model (MySQL; tenantId on every table for multi-tenancy).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String @id
  name            String
  code            String
  logoText        String
  primaryCurrency String
  country         String
  brandColor      String @default("#2050e0")
}

model User {
  id           String  @id
  tenantId     String
  name         String
  initials     String
  role         String
  department   String
  email        String  @unique
  passwordHash String?
  accessLevel  String  @default("member")

  @@index([tenantId])
}

model Customer {
  id         String    @id
  tenantId   String
  name       String
  type       String
  city       String
  state      String
  country    String
  gstin      String?
  rating     String
  since      String
  commercial Json?
  contacts   Contact[]

  @@index([tenantId])
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String
  email      String
  phone      String
  primary    Boolean  @default(false)

  @@index([customerId])
}

model Communication {
  id         String @id @default(cuid())
  tenantId   String
  customerId String
  type       String
  subject    String
  summary    String @db.Text
  userId     String
  date       String

  @@index([tenantId])
  @@index([customerId])
}

model Opportunity {
  id            String  @id
  tenantId      String
  title         String
  customerId    String
  stage         String
  value         Float
  currency      String  @default("INR")
  ownerId       String
  expectedClose String
  source        String
  projectId     String?
  lastActivity  String

  @@index([tenantId])
  @@index([customerId])
}

model Project {
  id             String         @id
  tenantId       String
  title          String
  customerId     String
  ownerId        String
  currentStage   String
  health         String
  priority       String
  value          Float
  currency       String         @default("INR")
  marginPct      Float?
  createdAt      String
  targetDelivery String?
  location       String
  productSummary String
  tags           Json
  stages         ProjectStage[]
  artifacts      Artifact[]

  @@index([tenantId])
  @@index([customerId])
}

model ProjectStage {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key         String
  state       String
  order       Int
  startedAt   String?
  completedAt String?
  ownerId     String?
  note        String? @db.Text

  @@index([projectId])
}

model Artifact {
  id              String         @id
  tenantId        String
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            String
  title           String
  status          String
  stage           String
  currentRevision Int            @default(1)
  ownerId         String
  updatedAt       String
  upstreamStale   Boolean        @default(false)
  meta            Json?
  revisions       Revision[]
  links           ArtifactLink[]

  @@index([tenantId])
  @@index([projectId])
}

model Revision {
  id            String   @id @default(cuid())
  artifactId    String
  artifact      Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  rev           Int
  createdAt     String
  authorId      String
  changeSummary String   @db.Text

  @@index([artifactId])
}

model ArtifactLink {
  id           String   @id @default(cuid())
  artifactId   String
  artifact     Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  toArtifactId String
  type         String
  atRevision   Int

  @@index([artifactId])
}

model ProductFamily {
  id             String  @id
  tenantId       String
  name           String
  category       String
  blurb          String  @db.Text
  attributeCount Int
  active         Boolean @default(true)
  schema         Json?

  @@index([tenantId])
}

// One flexible per-tenant configuration blob: commercial defaults, quotation
// template + clause libraries, units, tax codes. Keeps the product endlessly
// customizable without a migration per knob.
model TenantConfig {
  id       String @id @default(cuid())
  tenantId String @unique
  data     Json
}

model Configuration {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String?
  familyId  String
  name      String
  values    Json
  marginPct Float   @default(18)
  validated Boolean @default(true)
  createdAt String
  createdBy String

  @@index([tenantId])
  @@index([projectId])
}

model Quotation {
  id            String          @id @default(cuid())
  tenantId      String
  projectId     String          @unique
  customerId    String
  code          String          @unique
  revision      Int             @default(1)
  status        String
  validityDays  Int             @default(60)
  ownerId       String
  product       String
  lineItems     Json
  packing       Float
  freight       Float
  insurance     Float
  gstPct        Float           @default(18)
  paymentTerms  String
  deliveryWeeks Int
  scope         Json
  exclusions    Json
  terms         Json
  blocks        Json
  createdAt     String
  updatedAt     String
  revisions     QuoteRevision[]
  approvals     QuoteApproval[]

  @@index([tenantId])
}

model QuoteRevision {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rev         Int
  date        String
  authorId    String
  change      String    @db.Text

  @@index([quotationId])
}

model QuoteApproval {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  role        String
  userId      String
  status      String
  date        String?

  @@index([quotationId])
}

model ComplianceItem {
  id              String  @id @default(cuid())
  tenantId        String
  projectId       String
  clause          String
  category        String
  requirement     String  @db.Text
  companySpec     String  @db.Text
  status          String
  deviation       String? @db.Text
  engineerComment String? @db.Text
  engineerId      String

  @@index([tenantId])
  @@index([projectId])
}

model Vendor {
  id        String @id
  tenantId  String
  name      String
  category  String
  rating    String
  location  String
  onTimePct Int

  @@index([tenantId])
}

model MaterialReq {
  id         String  @id @default(cuid())
  tenantId   String
  projectId  String
  item       String
  category   String
  qty        Float
  unit       String
  requiredBy String
  vendorId   String
  poNo       String?
  status     String
  value      Float
  quotes     Json?

  @@index([tenantId])
  @@index([projectId])
}

model WorkOrder {
  id           String  @id
  tenantId     String
  projectId    String
  projectShort String
  unit         String
  stage        String
  operator     String
  machine      String
  startedAt    String
  progress     Int
  status       String
  issue        String? @db.Text

  @@index([tenantId])
  @@index([projectId])
}

model TestUnit {
  id           String       @id @default(cuid())
  tenantId     String
  projectId    String
  serial       String       @unique
  projectShort String
  product      String
  certIssued   Boolean      @default(false)
  issuedAt     String?
  tests        TestRecord[]

  @@index([tenantId])
  @@index([projectId])
}

model TestRecord {
  id         String   @id @default(cuid())
  testUnitId String
  unit       TestUnit @relation(fields: [testUnitId], references: [id], onDelete: Cascade)
  name       String
  category   String
  result     String
  value      String?
  limit      String?
  engineerId String
  witnessed  Boolean  @default(false)

  @@index([testUnitId])
}

model WorkflowConfig {
  id            String @id @default(cuid())
  tenantId      String
  artifactType  String
  label         String
  states        Json
  approvalChain Json

  @@index([tenantId])
}

model StandardRef {
  id       String  @id @default(cuid())
  tenantId String?
  code     String
  title    String
  scope    String

  @@index([tenantId])
}

model RateCard {
  id            String  @id @default(cuid())
  tenantId      String
  effectiveFrom String
  label         String
  active        Boolean @default(false)
  rates         Json
  factors       Json?

  @@index([tenantId])
}

model Activity {
  id        String  @id @default(cuid())
  tenantId  String
  projectId String?
  actorId   String
  verb      String
  target    String  @db.Text
  at        String

  @@index([tenantId])
}
