{
  "name": "candron-oneerp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3550",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/with-db-url.mjs prisma migrate deploy",
    "db:migrate:dev": "node scripts/with-db-url.mjs prisma migrate dev",
    "db:seed": "node scripts/with-db-url.mjs tsx prisma/seed.ts",
    "db:reset": "node scripts/with-db-url.mjs tsx prisma/seed.ts --reset",
    "postinstall": "prisma generate",
    "build": "node scripts/deploy-db.mjs && next build --webpack",
    "postbuild": "node scripts/standalone-assets.mjs",
    "start": "next start -p 3550",
    "start:standalone": "node .next/standalone/server.js",
    "start:prod": "node server.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.5",
    "lucide-react": "^0.469.0",
    "next": "^16.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
